<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PocketPay.Mobile.AccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Account">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20">

            <Label
                Text="My Account"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Border
                Padding="20"
                StrokeShape="RoundRectangle 15">

                <VerticalStackLayout
                    Spacing="15">

                    <Label
                        Text="Full Name"
                        FontSize="14" />

                    <Label
                        x:Name="FullNameLabel"
                        FontSize="20"
                        FontAttributes="Bold" />

                    <BoxView
                        HeightRequest="1" />

                    <Label
                        Text="Email"
                        FontSize="14" />

                    <Label
                        x:Name="EmailLabel"
                        FontSize="18" />

                    <BoxView
                        HeightRequest="1" />

                    <Label
                        Text="Wallet Number"
                        FontSize="14" />

                    <Label
                        x:Name="WalletNumberLabel"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <BoxView
                        HeightRequest="1" />

                    <Label
                        Text="Available Balance"
                        FontSize="14" />

                    <Label
                        x:Name="BalanceLabel"
                        FontSize="22"
                        FontAttributes="Bold" />

                </VerticalStackLayout>

            </Border>

            <Button
                Text="Logout"
                FontSize="18"
                HeightRequest="55"
                Clicked="OnLogoutClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>