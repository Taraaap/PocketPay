<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PocketPay.Mobile.HomePage"
    BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="20">

            <Label
                Text="PocketPay"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#1F2937" />

            <Label
                Text="My Wallet"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="#374151" />

            <Border
                BackgroundColor="White"
                StrokeShape="RoundRectangle 15"
                Padding="25">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Available Balance"
                        FontSize="16"
                        TextColor="#6B7280" />

                    <Label
                        x:Name="BalanceLabel"
                        Text="Loading..."
                        FontSize="32"
                        FontAttributes="Bold"
                        TextColor="#111827" />

                    <Label
                        x:Name="WalletNumberLabel"
                        Text="Wallet: Loading..."
                        FontSize="14"
                        TextColor="#6B7280" />

                </VerticalStackLayout>

            </Border>

            <Button
                Text="Deposit"
                HeightRequest="50"
                CornerRadius="10"
                Clicked="OnDepositClicked"/>

            <Button
                Text="Send Money"
                HeightRequest="50"
                CornerRadius="10" 
                Clicked="OnSendMoneyClicked"/>

            <Button
                Text="Transactions"
                HeightRequest="50"
                CornerRadius="10" 
                Clicked="OnTransactionsClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>