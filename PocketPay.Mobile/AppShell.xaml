<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="PocketPay.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PocketPay.Mobile"
    FlyoutBehavior="Disabled">

   
    <ShellContent
        x:Name="LoginItem"
        Title="Login"
        Route="MainPage"
        ContentTemplate="{DataTemplate local:MainPage}" />

   
    <ShellContent
        x:Name="HomeItem"
        Title="Home"
        Route="HomePage"
        ContentTemplate="{DataTemplate local:HomePage}" />

   
    <ShellContent
        x:Name="DepositItem"
        Title="Deposit"
        Route="DepositPage"
        ContentTemplate="{DataTemplate local:DepositPage}" />

   
    <ShellContent
        x:Name="SendMoneyItem"
        Title="Send Money"
        Route="SendMoneyPage"
        ContentTemplate="{DataTemplate local:SendMoneyPage}" />

   
    <ShellContent
        x:Name="TransactionsItem"
        Title="Transactions"
        Route="TransactionsPage"
        ContentTemplate="{DataTemplate local:TransactionsPage}" />

   
    <ShellContent
        x:Name="AccountItem"
        Title="Account"
        Route="AccountPage"
        ContentTemplate="{DataTemplate local:AccountPage}" />

   
    <MenuItem
        Text="Logout"
        Clicked="OnLogoutClicked" />

</Shell>

