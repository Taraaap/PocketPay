<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PocketPay.Mobile.DepositPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Deposit">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20">

            <Label
                Text="Deposit Money"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Enter the amount you want to add to your wallet."
                FontSize="16"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Entry
                x:Name="AmountEntry"
                Placeholder="Enter amount"
                Keyboard="Numeric"
                FontSize="20" />

            <Button
                Text="Deposit"
                FontSize="18"
                HeightRequest="55"
                Clicked="OnDepositClicked" />

            <Button
                Text="Cancel"
                FontSize="16"
                Clicked="OnCancelClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>