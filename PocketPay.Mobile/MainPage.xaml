<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PocketPay.Mobile.MainPage"
    BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="PocketPay"
                FontSize="36"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#1F2937" />

            <Label
                Text="Welcome Back 👋"
                FontSize="22"
                HorizontalOptions="Center"
                TextColor="#4B5563" />

            <Label
                Text="Email"
                FontAttributes="Bold"
                TextColor="#374151" />

            <Entry
                x:Name="EmailEntry"
                Placeholder="Enter your email"
                Keyboard="Email"
                BackgroundColor="White" />

            <Label
                Text="Password"
                FontAttributes="Bold"
                TextColor="#374151" />

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Enter your password"
                IsPassword="True"
                BackgroundColor="White" />

            <Button
                Text="LOGIN"
                Clicked="OnLoginClicked"
                HeightRequest="50"
                CornerRadius="10" />

            <Label
                Text="Don't have an account? Register"
                HorizontalOptions="Center"
                TextColor="#2563EB" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>