<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PocketPay.Mobile.SendMoneyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Send Money">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20">

            <Label
                Text="Send Money"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Send money to another PocketPay wallet."
                FontSize="16"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Entry
                x:Name="WalletNumberEntry"
                Placeholder="Recipient wallet number"
                FontSize="18"
                Keyboard="Text" />

            <Entry
                x:Name="AmountEntry"
                Placeholder="Amount"
                FontSize="18"
                Keyboard="Numeric" />

            <Button
                Text="Send Money"
                FontSize="18"
                HeightRequest="55"
                Clicked="OnSendMoneyClicked" />

            <Button
                Text="Cancel"
                FontSize="16"
                Clicked="OnCancelClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>